<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="reporte_diario_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_gt_extra.reporte_diario.wizard</field>
        <field name="model">l10n_gt_extra.reporte_diario.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Seleccione cuentas y rango de fecha">
                <group>
                    <group>
                        <field name="folio_inicial"/>
                        <field name="contacto_encabezado"/>
                        <field name="fecha_desde" string="Fechas" widget="daterange" options="{'end_date_field': 'fecha_hasta'}"/>
                    </group>
                    <group>
                        <field name="agrupado_por_dia"/>
                        <field name="name" invisible="1"/>
                        <field name="archivo" readonly="1" filename="name"/>
                    </group>
                </group>
                <separator colspan="4" string="Cuentas"/>
                <field name="cuentas_id" nolabel="1"/>
                <footer>
                    <button name="print_report" string="Reporte" type="object" class="oe_highlight"/>
                    <button name="print_report_excel" string="Reporte excel" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reporte_diario_wizard_action" model="ir.actions.act_window">
        <field name="name">Libro de Diario</field>
        <field name="res_model">l10n_gt_extra.reporte_diario.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="target">new</field>
    </record>

    <record id="reporte_diario_wizard_report" model="ir.actions.report">
        <field name="name">l10n_gt_extra.reporte_diario</field>
        <field name="model">l10n_gt_extra.reporte_diario.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_extra.reporte_diario</field>
        <field name="report_file">l10n_gt_extra.reporte_diario</field>
    </record>

    <menuitem id="reporte_diario_wizard_menu" action="reporte_diario_wizard_action" parent="menu_informes"/>

</odoo>
