<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_cargar_impuestos" model="ir.actions.server">
        <field name="name">Cargar impuestos GT</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="binding_model_id" ref="base.model_res_company"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = record.cargar_impuestos()
        </field>
    </record>

    <record id="action_cargar_impuestos_globales" model="ir.actions.server">
        <field name="name">Cargar impuestos globales GT</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="binding_model_id" ref="base.model_res_company"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = record.cargar_impuestos_globales()
        </field>
    </record>

</odoo>