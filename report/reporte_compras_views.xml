<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="reporte_compras">
                <t t-call="web.html_container">
            <t t-set="data_report_page_offset" t-value="data['folio_inicial']+1"/>
            <t t-set="data_report_margin_top" t-value="20"/>
            <t t-set="data_report_header_spacing" t-value="10"/>
            <div class="header">
                Folio: <span class="page" t-esc="data['folio_inicial']-1"></span>
            </div>
            <t t-call="web.external_layout">
                <div class="page">
                    <h2><span t-esc="current_company_id.name"/>: Libro de compras y servicios</h2>

                    <div class="row my-2">
                        <div class="col-6">
                            <strong>Número de identificación tributaria:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Nombre comercial:</strong> <span t-esc="direccion_diario.name if direccion_diario else current_company_id.partner_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Domicilio fiscal:</strong> <span t-esc="direccion_diario._display_address(without_company=True) if direccion_diario else current_company_id.partner_id._display_address(without_company=True)"/><br/>
                            <strong>Registro del:</strong> <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/> <strong>al:</strong> <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>

                    <t t-set="result" t-value="lineas(data)"/>

                    <table class="table table-sm" style="font-size: 90%">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Fecha</th>
                                <th>Doc</th>
                                <th>Proveedor</th>
                                <th>NIT</th>
                                <th t-if="'bl' in columnas_mostrar" class="text-end">Bien. loc.</th>
                                <th t-if="'ble' in columnas_mostrar" class="text-end">Bien. loc. exe.</th>
                                <th t-if="'be' in columnas_mostrar" class="text-end">Bien. ext.</th>
                                <th t-if="'bee' in columnas_mostrar" class="text-end">Bien. ext. exe.</th>
                                <th t-if="'sl' in columnas_mostrar" class="text-end">Serv. loc.</th>
                                <th t-if="'sle' in columnas_mostrar" class="text-end">Serv. loc. exe.</th>
                                <th t-if="'se' in columnas_mostrar" class="text-end">Serv. ext.</th>
                                <th t-if="'see' in columnas_mostrar" class="text-end">Serv. ext. exe.</th>
                                <th t-if="'cl' in columnas_mostrar" class="text-end">Comb. loc.</th>
                                <th t-if="'cle' in columnas_mostrar" class="text-end">Comb. loc. exe.</th>
                                <th t-if="'ce' in columnas_mostrar" class="text-end">Comb. ext.</th>
                                <th t-if="'cee' in columnas_mostrar" class="text-end">Comb. ext. exe.</th>
                                <th t-if="'p' in columnas_mostrar" class="text-end">Peq.</th>
                                <th class="text-end">IVA</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td>
                                    <span t-esc="l['tipo']"/>
                                </td>
                                <td>
                                    <span t-esc="l['fecha']" t-options="{'widget': 'date'}"/>
                                </td>
                                <td>
                                    <span t-esc="l['numero']"/>
                                </td>
                                <td>
                                    <span t-esc="l['proveedor'].name"/>
                                </td>
                                <td>
                                    <span t-esc="l['proveedor'].vat or l['proveedor'].cui"/>
                                </td>
                                <td t-if="'bl' in columnas_mostrar" class="text-end">
                                     <span t-esc="l['bien_local']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'ble' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['bien_local_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'be' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['bien_extranjero']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'bee' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['bien_extranjero_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'sl' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['servicio_local']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'sle' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['servicio_local_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'se' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['servicio_extranjero']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'see' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['servicio_extranjero_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'cl' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['combustible_local']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'cle' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['combustible_local_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'ce' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['combustible_extranjero']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'cee' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['combustible_extranjero_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'p' in columnas_mostrar" class="text-end">
                                    <span t-esc="l['pequeño']+l['pequeño_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="l['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="l['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td>
                                    Totales
                                </td>
                                <td>
                                </td>
                                <td t-if="'bl' in columnas_mostrar" class="text-end">
                                     <span t-esc="result['totales']['bien_local']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'ble' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['bien_local']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'be' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['bien_extranjero']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'bee' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['bien_extranjero']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'sl' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['servicio_local']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'sle' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['servicio_local']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'se' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['servicio_extranjero']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'see' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['servicio_extranjero']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'cl' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['combustible_local']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'cle' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['combustible_local']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'ce' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['combustible_extranjero']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'cee' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['combustible_extranjero']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td t-if="'p' in columnas_mostrar" class="text-end">
                                    <span t-esc="result['totales']['pequeño']['neto']+result['totales']['pequeño']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['iva'] + result['totales']['bien_extranjero']['iva'] + result['totales']['servicio_local']['iva'] + result['totales']['servicio_extranjero']['iva'] + result['totales']['combustible_local']['iva'] + result['totales']['combustible_extranjero']['iva'] + result['totales']['pequeño']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['total'] + result['totales']['bien_extranjero']['total'] + result['totales']['servicio_local']['total'] + result['totales']['servicio_extranjero']['total'] + result['totales']['combustible_local']['total'] + result['totales']['combustible_extranjero']['total'] + result['totales']['pequeño']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mt-2">
                        <span>Cantidad de facturas:</span>
                        <strong t-esc="'{0:,.0f}'.format(result['totales']['num_facturas'])"/>
                    </div>
                    <div class="mb-2">
                        <span>Total crédito fiscal:</span>
                        <strong t-esc="result['totales']['bien_local']['iva'] + result['totales']['bien_extranjero']['iva'] + result['totales']['servicio_local']['iva'] + result['totales']['servicio_extranjero']['iva'] + result['totales']['combustible_local']['iva'] + result['totales']['combustible_extranjero']['iva'] + result['totales']['pequeño']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                    </div>

                    <div><strong>Resumen:</strong></div>
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="text-end">Exento</th>
                                <th class="text-end">Neto</th>
                                <th class="text-end">IVA</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    Bienes locales
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Servicios locales
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_local']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_local']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_local']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_local']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Combustibles locales
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_local']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_local']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_local']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_local']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Bienes extranjeros
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_extranjero']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_extranjero']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_extranjero']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_extranjero']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Servicios extranjeros
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_extranjero']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_extranjero']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_extranjero']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['servicio_extranjero']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Combustibles extranjeros
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_extranjero']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_extranjero']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_extranjero']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['combustible_extranjero']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Pequeños contribuyentes
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['pequeño']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['pequeño']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['pequeño']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['pequeño']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>
                                    Totales
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['exento'] + result['totales']['bien_extranjero']['exento'] + result['totales']['servicio_local']['exento'] + result['totales']['servicio_extranjero']['exento'] + result['totales']['combustible_local']['exento'] + result['totales']['combustible_extranjero']['exento'] + result['totales']['pequeño']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['neto'] + result['totales']['bien_extranjero']['neto'] + result['totales']['servicio_local']['neto'] + result['totales']['servicio_extranjero']['neto'] + result['totales']['combustible_local']['neto'] + result['totales']['combustible_extranjero']['neto'] + result['totales']['pequeño']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['iva'] + result['totales']['bien_extranjero']['iva'] + result['totales']['servicio_local']['iva'] + result['totales']['servicio_extranjero']['iva'] + result['totales']['combustible_local']['iva'] + result['totales']['combustible_extranjero']['iva'] + result['totales']['pequeño']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="result['totales']['bien_local']['total'] + result['totales']['bien_extranjero']['total'] + result['totales']['servicio_local']['total'] + result['totales']['servicio_extranjero']['total'] + result['totales']['combustible_local']['total'] + result['totales']['combustible_extranjero']['total'] + result['totales']['pequeño']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
